<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>المعتصم بالله الرميلي | موقع شخصي</title>
<meta name="description" content="الموقع الشخصي للمعتصم بالله محمد عبد السلام الرميلي — طالب هندسة برمجيات، جامعة المرقب.">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;800&family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet">

<style>
/* ===================================================
   المتغيرات العامة - الألوان والثيمات
=================================================== */
:root{
  --bg:#f4f7fb;
  --bg-2:#e9eef7;
  --surface:#ffffff;
  --surface-2:#f8fafc;
  --text:#16233a;
  --muted:#5f7089;
  --border:rgba(22,35,58,.09);
  --primary:#0ea5a5;
  --primary-2:#4f7cf7;
  --accent:#7c5cff;
  --shadow:0 10px 30px rgba(22,35,58,.08);
  --shadow-lg:0 22px 55px rgba(22,35,58,.14);
  --grad:linear-gradient(135deg,#0ea5a5 0%,#4f7cf7 55%,#7c5cff 100%);
  --radius:22px;
  --radius-sm:14px;
  --nav-h:72px;
}

html[data-theme="dark"]{
  --bg:#080d1a;
  --bg-2:#0d1424;
  --surface:#121b2e;
  --surface-2:#16203a;
  --text:#e9eefb;
  --muted:#9aabc6;
  --border:rgba(255,255,255,.09);
  --primary:#2dd4bf;
  --primary-2:#6b93ff;
  --accent:#a78bfa;
  --shadow:0 10px 30px rgba(0,0,0,.35);
  --shadow-lg:0 22px 55px rgba(0,0,0,.5);
}

/* ===================================================
   أساسيات
=================================================== */
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:calc(var(--nav-h) + 16px)}
body{
  font-family:'Cairo','Tajawal',system-ui,-apple-system,"Segoe UI",sans-serif;
  background:var(--bg);
  color:var(--text);
  line-height:1.85;
  overflow-x:hidden;
  transition:background .45s ease,color .45s ease;
}
img{max-width:100%;display:block}
a{text-decoration:none;color:inherit}
ul{list-style:none}
button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit}

/* خلفية زخرفية */
.bg-decor{
  position:fixed;inset:0;z-index:-1;overflow:hidden;pointer-events:none;
}
.bg-decor span{
  position:absolute;border-radius:50%;filter:blur(90px);opacity:.30;
  animation:float 18s ease-in-out infinite;
}
.bg-decor span:nth-child(1){width:420px;height:420px;background:var(--primary);top:-120px;right:-100px}
.bg-decor span:nth-child(2){width:380px;height:380px;background:var(--accent);bottom:-140px;left:-120px;animation-delay:-6s}
.bg-decor span:nth-child(3){width:300px;height:300px;background:var(--primary-2);top:45%;left:45%;animation-delay:-11s;opacity:.18}
html[data-theme="dark"] .bg-decor span{opacity:.22}

@keyframes float{
  0%,100%{transform:translate(0,0) scale(1)}
  33%{transform:translate(30px,-40px) scale(1.08)}
  66%{transform:translate(-25px,25px) scale(.95)}
}

/* ===================================================
   شريط التنقل
=================================================== */
.nav{
  position:fixed;top:0;right:0;left:0;z-index:1000;
  height:var(--nav-h);
  display:flex;align-items:center;
  backdrop-filter:blur(18px);
  -webkit-backdrop-filter:blur(18px);
  background:color-mix(in srgb,var(--bg) 78%,transparent);
  border-bottom:1px solid transparent;
  transition:all .35s ease;
}
.nav.scrolled{
  border-bottom-color:var(--border);
  box-shadow:0 6px 24px rgba(0,0,0,.06);
  height:64px;
}
.nav-inner{
  width:min(1160px,92%);margin-inline:auto;
  display:flex;align-items:center;justify-content:space-between;gap:18px;
}
.brand{display:flex;align-items:center;gap:11px;font-weight:800;font-size:1.05rem;letter-spacing:.2px}
.brand-logo{
  width:42px;height:42px;border-radius:13px;background:var(--grad);
  display:grid;place-items:center;color:#fff;font-weight:800;font-size:1.15rem;
  box-shadow:0 8px 20px rgba(79,124,247,.35);
  transition:transform .4s cubic-bezier(.34,1.56,.64,1);
}
.brand:hover .brand-logo{transform:rotate(-10deg) scale(1.08)}
.brand-text small{display:block;font-size:.68rem;font-weight:500;color:var(--muted);line-height:1;margin-top:2px}

.nav-links{display:flex;align-items:center;gap:4px}
.nav-links a{
  position:relative;padding:9px 15px;border-radius:11px;
  font-size:.93rem;font-weight:600;color:var(--muted);
  transition:all .25s ease;
}
.nav-links a::after{
  content:'';position:absolute;bottom:5px;right:50%;transform:translateX(50%);
  width:0;height:2px;border-radius:2px;background:var(--grad);transition:width .3s ease;
}
.nav-links a:hover{color:var(--text);background:var(--surface)}
.nav-links a:hover::after,.nav-links a.active::after{width:22px}
.nav-links a.active{color:var(--text)}

.nav-actions{display:flex;align-items:center;gap:9px}
.icon-btn{
  width:42px;height:42px;border-radius:13px;
  display:grid;place-items:center;
  background:var(--surface);border:1px solid var(--border);
  color:var(--text);transition:all .28s ease;
}
.icon-btn:hover{transform:translateY(-3px);box-shadow:var(--shadow);border-color:transparent}
.icon-btn svg{width:19px;height:19px;fill:currentColor}
.sun-icon{display:none}
html[data-theme="dark"] .sun-icon{display:block}
html[data-theme="dark"] .moon-icon{display:none}

.burger{display:none;width:44px;height:44px;border-radius:13px;background:var(--surface);border:1px solid var(--border);place-items:center}
.burger span{display:block;width:19px;height:2px;background:var(--text);border-radius:2px;margin:3.5px 0;transition:.3s}
.burger.open span:nth-child(1){transform:translateY(5.5px) rotate(45deg)}
.burger.open span:nth-child(2){opacity:0}
.burger.open span:nth-child(3){transform:translateY(-5.5px) rotate(-45deg)}

/* ===================================================
   الأزرار
=================================================== */
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:9px;
  padding:13px 26px;border-radius:15px;
  font-weight:700;font-size:.95rem;
  transition:all .3s cubic-bezier(.34,1.3,.64,1);
  position:relative;overflow:hidden;
}
.btn svg{width:18px;height:18px;fill:currentColor;flex-shrink:0}
.btn-primary{
  background:var(--grad);color:#fff;
  box-shadow:0 12px 28px rgba(79,124,247,.35);
}
.btn-primary:hover{transform:translateY(-4px);box-shadow:0 18px 38px rgba(79,124,247,.45)}
.btn-ghost{
  background:var(--surface);color:var(--text);
  border:1px solid var(--border);box-shadow:var(--shadow);
}
.btn-ghost:hover{transform:translateY(-4px);border-color:var(--primary);color:var(--primary)}

/* ===================================================
   الحاويات والأقسام
=================================================== */
.container{width:min(1160px,92%);margin-inline:auto}
section{padding:96px 0;position:relative}
.section-head{text-align:center;margin-bottom:56px}
.eyebrow{
  display:inline-flex;align-items:center;gap:8px;
  padding:7px 17px;border-radius:999px;
  background:var(--surface);border:1px solid var(--border);
  color:var(--primary);font-size:.8rem;font-weight:700;
  margin-bottom:16px;box-shadow:var(--shadow);
}
.eyebrow::before{content:'';width:7px;height:7px;border-radius:50%;background:var(--grad)}
.section-head h2{
  font-size:clamp(1.7rem,4vw,2.5rem);font-weight:800;letter-spacing:-.5px;line-height:1.35;
}
.section-head h2 em{
  font-style:normal;background:var(--grad);
  -webkit-background-clip:text;background-clip:text;color:transparent;
}
.section-head p{color:var(--muted);max-width:600px;margin:12px auto 0;font-size:1rem}

/* ===================================================
   القسم الرئيسي
=================================================== */
.hero{
  min-height:100vh;display:flex;align-items:center;
  padding-top:calc(var(--nav-h) + 50px);padding-bottom:70px;
}
.hero-grid{
  display:grid;grid-template-columns:1.15fr .85fr;
  gap:60px;align-items:center;
}
.hero-badge{
  display:inline-flex;align-items:center;gap:9px;
  padding:8px 18px;border-radius:999px;
  background:var(--surface);border:1px solid var(--border);
  font-size:.83rem;font-weight:600;color:var(--muted);
  box-shadow:var(--shadow);margin-bottom:22px;
}
.pulse{
  width:9px;height:9px;border-radius:50%;background:#22c55e;position:relative;
}
.pulse::after{
  content:'';position:absolute;inset:0;border-radius:50%;background:#22c55e;
  animation:pulse 2s ease-out infinite;
}
@keyframes pulse{0%{transform:scale(1);opacity:.7}100%{transform:scale(3.2);opacity:0}}

.hero h1{
  font-size:clamp(2rem,5.4vw,3.5rem);
  font-weight:800;line-height:1.28;letter-spacing:-1px;margin-bottom:8px;
}
.hero h1 .grad{
  background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent;
}
.hero .role{
  font-size:clamp(1rem,2.4vw,1.28rem);font-weight:600;color:var(--muted);margin-bottom:20px;
}
.hero .role b{color:var(--primary);font-weight:700}
.hero p.lead{
  color:var(--muted);font-size:1.02rem;max-width:560px;margin-bottom:34px;
}
.hero-cta{display:flex;flex-wrap:wrap;gap:14px;margin-bottom:38px}

.hero-socials{display:flex;flex-wrap:wrap;gap:11px}
.soc-mini{
  width:46px;height:46px;border-radius:14px;
  display:grid;place-items:center;
  background:var(--surface);border:1px solid var(--border);
  color:var(--muted);box-shadow:var(--shadow);
  transition:all .3s cubic-bezier(.34,1.4,.64,1);
}
.soc-mini svg{width:20px;height:20px;fill:currentColor}
.soc-mini:hover{transform:translateY(-6px) scale(1.06);color:#fff;border-color:transparent}
.soc-mini.fb:hover{background:#1877f2}
.soc-mini.tg:hover{background:#29a9eb}
.soc-mini.ig:hover{background:linear-gradient(45deg,#f09433,#dc2743,#bc1888)}
.soc-mini.wa:hover{background:#25d366}
.soc-mini.li:hover{background:#0a66c2}
.soc-mini.em:hover{background:#ea4335}
.soc-mini.vb:hover{background:#7360f2}

/* بطاقة الصورة */
.hero-card{
  position:relative;
  display:grid;place-items:center;
}
.avatar-wrap{
  position:relative;width:min(330px,80vw);aspect-ratio:1;
  border-radius:50%;
  background:var(--grad);
  padding:6px;
  box-shadow:0 30px 70px rgba(79,124,247,.32);
  animation:floatY 6s ease-in-out infinite;
}
@keyframes floatY{0%,100%{transform:translateY(0)}50%{transform:translateY(-16px)}}
.avatar{
  width:100%;height:100%;border-radius:50%;
  background:var(--surface);
  display:grid;place-items:center;overflow:hidden;
  border:5px solid var(--bg);
}
.avatar img{width:100%;height:100%;object-fit:cover}
.avatar .initials{
  font-size:clamp(4rem,12vw,6.5rem);font-weight:800;
  background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent;
}
.ring{
  position:absolute;inset:-22px;border-radius:50%;
  border:2px dashed var(--border);
  animation:spin 28s linear infinite;
}
@keyframes spin{to{transform:rotate(360deg)}}

.chip{
  position:absolute;
  background:var(--surface);border:1px solid var(--border);
  border-radius:16px;padding:11px 16px;
  box-shadow:var(--shadow-lg);
  display:flex;align-items:center;gap:10px;
  font-size:.82rem;font-weight:700;
  animation:floatY 5s ease-in-out infinite;
}
.chip svg{width:20px;height:20px;fill:var(--primary)}
.chip.c1{top:6%;right:-6%;animation-delay:-1s}
.chip.c2{bottom:12%;left:-8%;animation-delay:-3s}
.chip.c3{bottom:-2%;right:8%;animation-delay:-2s}
.chip small{display:block;font-size:.68rem;color:var(--muted);font-weight:500}

/* ===================================================
   نبذة عني / المعلومات الشخصية
=================================================== */
.about-grid{
  display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));
  gap:18px;
}
.info-card{
  background:var(--surface);
  border:1px solid var(--border);
  border-radius:var(--radius);
  padding:24px 22px;
  box-shadow:var(--shadow);
  transition:all .35s cubic-bezier(.34,1.2,.64,1);
  position:relative;overflow:hidden;
}
.info-card::before{
  content:'';position:absolute;top:0;right:0;width:100%;height:3px;
  background:var(--grad);transform:scaleX(0);transform-origin:right;transition:transform .4s ease;
}
.info-card:hover::before{transform:scaleX(1)}
.info-card:hover{transform:translateY(-7px);box-shadow:var(--shadow-lg);border-color:transparent}
.info-icon{
  width:48px;height:48px;border-radius:15px;
  display:grid;place-items:center;margin-bottom:14px;
  background:linear-gradient(135deg,color-mix(in srgb,var(--primary) 18%,transparent),color-mix(in srgb,var(--accent) 18%,transparent));
  color:var(--primary);
}
.info-icon svg{width:23px;height:23px;fill:currentColor}
.info-card h4{font-size:.79rem;font-weight:600;color:var(--muted);letter-spacing:.3px;margin-bottom:5px}
.info-card p{font-size:1.02rem;font-weight:700;line-height:1.5;word-break:break-word}
.blood{
  display:inline-flex;align-items:center;gap:7px;
  background:linear-gradient(135deg,#ef4444,#f97316);color:#fff;
  padding:3px 14px;border-radius:999px;font-size:.95rem;font-weight:800;
}

/* ===================================================
   الخط الزمني للتعليم
=================================================== */
.timeline{position:relative;max-width:900px;margin-inline:auto}
.timeline::before{
  content:'';position:absolute;top:0;bottom:0;right:23px;
  width:2px;background:linear-gradient(to bottom,var(--primary),var(--accent),transparent);
  border-radius:2px;
}
.tl-item{
  position:relative;padding-right:74px;margin-bottom:30px;
}
.tl-dot{
  position:absolute;top:8px;right:0;
  width:48px;height:48px;border-radius:15px;
  background:var(--grad);color:#fff;
  display:grid;place-items:center;
  box-shadow:0 10px 24px rgba(79,124,247,.35);
  border:4px solid var(--bg);
  z-index:2;
}
.tl-dot svg{width:21px;height:21px;fill:currentColor}
.tl-card{
  background:var(--surface);border:1px solid var(--border);
  border-radius:var(--radius);overflow:hidden;
  box-shadow:var(--shadow);
  transition:all .35s cubic-bezier(.34,1.2,.64,1);
}
.tl-card:hover{transform:translateX(-8px);box-shadow:var(--shadow-lg);border-color:transparent}
.tl-media{
  position:relative;height:165px;overflow:hidden;
  background:linear-gradient(135deg,var(--bg-2),var(--surface-2));
  display:grid;place-items:center;
}
.tl-media img{position:relative;z-index:1;width:100%;height:100%;object-fit:cover}
.tl-media .ph{
  position:absolute;inset:0;display:grid;place-items:center;gap:6px;
  align-content:center;color:var(--muted);font-size:.8rem;font-weight:600;
}
.tl-media .ph svg{width:34px;height:34px;fill:currentColor;opacity:.5}
.tl-body{padding:22px 24px}
.tl-body .yr{
  display:inline-block;padding:4px 14px;border-radius:999px;
  background:linear-gradient(135deg,color-mix(in srgb,var(--primary) 15%,transparent),color-mix(in srgb,var(--accent) 15%,transparent));
  color:var(--primary);font-size:.75rem;font-weight:800;margin-bottom:10px;
}
.tl-body h3{font-size:1.15rem;font-weight:800;margin-bottom:4px}
.tl-body .place{color:var(--muted);font-size:.9rem;font-weight:600;margin-bottom:8px;display:flex;align-items:center;gap:6px}
.tl-body .place svg{width:15px;height:15px;fill:var(--primary);flex-shrink:0}
.tl-body p{color:var(--muted);font-size:.92rem}

/* ===================================================
   شبكة التواصل الاجتماعي
=================================================== */
.social-grid{
  display:grid;grid-template-columns:repeat(auto-fit,minmax(255px,1fr));gap:18px;
}
.soc-card{
  position:relative;overflow:hidden;
  background:var(--surface);border:1px solid var(--border);
  border-radius:var(--radius);padding:26px 24px;
  box-shadow:var(--shadow);
  display:flex;align-items:center;gap:17px;
  transition:all .35s cubic-bezier(.34,1.2,.64,1);
}
.soc-card::after{
  content:'';position:absolute;inset:0;opacity:0;transition:opacity .35s ease;
  background:var(--brand-grad);z-index:0;
}
.soc-card:hover::after{opacity:1}
.soc-card:hover{transform:translateY(-8px);box-shadow:var(--shadow-lg);border-color:transparent}
.soc-card:hover *{color:#fff !important;position:relative;z-index:1}
.soc-card:hover .soc-ico{background:rgba(255,255,255,.22);color:#fff}
.soc-card:hover .soc-arrow{transform:translateX(-5px);opacity:1}

.soc-ico{
  width:56px;height:56px;border-radius:17px;flex-shrink:0;
  display:grid;place-items:center;
  background:var(--brand-soft);color:var(--brand);
  transition:all .35s ease;
}
.soc-ico svg{width:26px;height:26px;fill:currentColor}
.soc-txt{flex:1;min-width:0}
.soc-txt h3{font-size:1.02rem;font-weight:800;margin-bottom:2px}
.soc-txt span{font-size:.82rem;color:var(--muted);display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;direction:ltr;text-align:right}
.soc-arrow{opacity:.35;transition:all .35s ease;color:var(--muted)}
.soc-arrow svg{width:18px;height:18px;fill:currentColor}

.soc-card.fb{--brand:#1877f2;--brand-soft:rgba(24,119,242,.12);--brand-grad:linear-gradient(135deg,#1877f2,#4293ff)}
.soc-card.wa{--brand:#25d366;--brand-soft:rgba(37,211,102,.12);--brand-grad:linear-gradient(135deg,#25d366,#0fb954)}
.soc-card.tg{--brand:#29a9eb;--brand-soft:rgba(41,169,235,.12);--brand-grad:linear-gradient(135deg,#29a9eb,#1c8dc7)}
.soc-card.ig{--brand:#dc2743;--brand-soft:rgba(220,39,67,.12);--brand-grad:linear-gradient(45deg,#f09433,#dc2743,#bc1888)}
.soc-card.li{--brand:#0a66c2;--brand-soft:rgba(10,102,194,.12);--brand-grad:linear-gradient(135deg,#0a66c2,#2f8ee0)}
.soc-card.em{--brand:#ea4335;--brand-soft:rgba(234,67,53,.12);--brand-grad:linear-gradient(135deg,#ea4335,#f97316)}
.soc-card.vb{--brand:#7360f2;--brand-soft:rgba(115,96,242,.12);--brand-grad:linear-gradient(135deg,#7360f2,#9b8bff)}
.soc-card.ph{--brand:#0ea5a5;--brand-soft:rgba(14,165,165,.12);--brand-grad:linear-gradient(135deg,#0ea5a5,#4f7cf7)}

/* ===================================================
   اتصل بي
=================================================== */
.contact-wrap{
  display:grid;grid-template-columns:1fr 1fr;gap:22px;
  background:var(--surface);border:1px solid var(--border);
  border-radius:28px;overflow:hidden;box-shadow:var(--shadow-lg);
}
.contact-info{
  padding:48px 42px;
  background:var(--grad);color:#fff;position:relative;overflow:hidden;
}
.contact-info::before{
  content:'';position:absolute;width:280px;height:280px;border-radius:50%;
  background:rgba(255,255,255,.10);bottom:-110px;left:-80px;
}
.contact-info::after{
  content:'';position:absolute;width:180px;height:180px;border-radius:50%;
  background:rgba(255,255,255,.08);top:-70px;right:-50px;
}
.contact-info h3{font-size:1.55rem;font-weight:800;margin-bottom:12px;position:relative;z-index:1}
.contact-info > p{opacity:.92;font-size:.95rem;margin-bottom:30px;position:relative;z-index:1}
.ci-item{
  display:flex;align-items:center;gap:14px;margin-bottom:18px;
  position:relative;z-index:1;
}
.ci-item .ic{
  width:46px;height:46px;border-radius:14px;flex-shrink:0;
  background:rgba(255,255,255,.18);display:grid;place-items:center;
  backdrop-filter:blur(6px);
}
.ci-item .ic svg{width:21px;height:21px;fill:#fff}
.ci-item small{display:block;font-size:.75rem;opacity:.85}
.ci-item b{font-size:.96rem;font-weight:700;direction:ltr;display:inline-block}

.contact-form{padding:48px 42px}
.field{margin-bottom:18px}
.field label{display:block;font-size:.85rem;font-weight:700;margin-bottom:8px;color:var(--muted)}
.field input,.field textarea{
  width:100%;padding:14px 17px;
  border-radius:14px;border:1.5px solid var(--border);
  background:var(--surface-2);color:var(--text);
  font-family:inherit;font-size:.94rem;
  transition:all .28s ease;resize:vertical;
}
.field input:focus,.field textarea:focus{
  outline:none;border-color:var(--primary);
  box-shadow:0 0 0 4px color-mix(in srgb,var(--primary) 14%,transparent);
  background:var(--surface);
}
.field textarea{min-height:130px}
.form-note{font-size:.82rem;color:var(--muted);margin-top:14px;text-align:center}

/* ===================================================
   التذييل
=================================================== */
footer{
  padding:44px 0 34px;border-top:1px solid var(--border);
  background:color-mix(in srgb,var(--surface) 55%,transparent);
}
.foot-inner{
  display:flex;flex-wrap:wrap;gap:20px;
  align-items:center;justify-content:space-between;
}
.foot-brand{display:flex;align-items:center;gap:11px;font-weight:800}
.foot-links{display:flex;flex-wrap:wrap;gap:6px}
.foot-links a{
  padding:7px 14px;border-radius:10px;font-size:.87rem;
  color:var(--muted);font-weight:600;transition:all .25s ease;
}
.foot-links a:hover{background:var(--surface);color:var(--primary)}
.copy{text-align:center;color:var(--muted);font-size:.83rem;margin-top:26px;padding-top:22px;border-top:1px solid var(--border)}
.copy b{background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}

/* زر العودة للأعلى */
.to-top{
  position:fixed;bottom:26px;left:26px;z-index:900;
  width:50px;height:50px;border-radius:16px;
  background:var(--grad);color:#fff;
  display:grid;place-items:center;
  box-shadow:0 14px 32px rgba(79,124,247,.4);
  opacity:0;visibility:hidden;transform:translateY(20px) scale(.9);
  transition:all .38s cubic-bezier(.34,1.3,.64,1);
}
.to-top.show{opacity:1;visibility:visible;transform:translateY(0) scale(1)}
.to-top:hover{transform:translateY(-5px) scale(1.06)}
.to-top svg{width:21px;height:21px;fill:currentColor}

/* شريط تقدم القراءة */
.progress{
  position:fixed;top:0;right:0;height:3px;width:0;
  background:var(--grad);z-index:1100;transition:width .12s linear;
}

/* ===================================================
   حركات الظهور
=================================================== */
.reveal{opacity:0;transform:translateY(34px);transition:opacity .75s ease,transform .75s cubic-bezier(.22,1,.36,1)}
.reveal.in{opacity:1;transform:none}
.reveal[data-d="1"]{transition-delay:.08s}
.reveal[data-d="2"]{transition-delay:.16s}
.reveal[data-d="3"]{transition-delay:.24s}
.reveal[data-d="4"]{transition-delay:.32s}
.reveal[data-d="5"]{transition-delay:.40s}
.reveal[data-d="6"]{transition-delay:.48s}

/* ===================================================
   الاستجابة للشاشات
=================================================== */
@media (max-width:980px){
  .hero-grid{grid-template-columns:1fr;gap:52px;text-align:center}
  .hero .lead{margin-inline:auto}
  .hero-cta,.hero-socials{justify-content:center}
  .hero-card{order:-1}
  .contact-wrap{grid-template-columns:1fr}
  .chip.c1{right:0}
  .chip.c2{left:0}
}
@media (max-width:820px){
  .nav-links{
    position:fixed;top:var(--nav-h);right:0;left:0;
    flex-direction:column;align-items:stretch;gap:4px;
    background:var(--surface);border-bottom:1px solid var(--border);
    padding:16px;box-shadow:var(--shadow-lg);
    transform:translateY(-130%);opacity:0;pointer-events:none;
    transition:all .4s cubic-bezier(.22,1,.36,1);
  }
  .nav-links.open{transform:translateY(0);opacity:1;pointer-events:auto}
  .nav-links a{padding:13px 18px;border-radius:12px;font-size:.98rem}
  .burger{display:grid}
  section{padding:74px 0}
  .contact-info,.contact-form{padding:34px 24px}
  .tl-item{padding-right:64px}
  .timeline::before{right:20px}
  .tl-dot{width:42px;height:42px;border-radius:13px}
}
@media (max-width:520px){
  .avatar-wrap{width:74vw}
  .chip{font-size:.74rem;padding:9px 13px}
  .chip.c1{right:-2%}
  .chip.c2{left:-2%}
  .btn{width:100%}
  .hero-cta{flex-direction:column;width:100%}
  .soc-card{padding:20px 18px}
  .soc-txt span{font-size:.76rem}
}
@media (prefers-reduced-motion:reduce){
  *{animation:none !important;transition-duration:.01ms !important}
  html{scroll-behavior:auto}
}
</style>
</head>

<body>

<!-- شريط التقدم -->
<div class="progress" id="progress"></div>

<!-- خلفية زخرفية -->
<div class="bg-decor"><span></span><span></span><span></span></div>

<!-- ===================== شريط التنقل ===================== -->
<header class="nav" id="nav">
  <div class="nav-inner">
    <a href="#home" class="brand" aria-label="الرئيسية">
      <div class="brand-logo">م</div>
      <div class="brand-text">
        المعتصم بالله
        <small>هندسة البرمجيات</small>
      </div>
    </a>

    <nav class="nav-links" id="navLinks">
      <a href="#home" class="active">الرئيسية</a>
      <a href="#about">نبذة عني</a>
      <a href="#education">التعليم</a>
      <a href="#social">تواصل اجتماعي</a>
      <a href="#contact">اتصل بي</a>
    </nav>

    <div class="nav-actions">
      <button class="icon-btn" id="themeBtn" aria-label="تبديل الوضع الليلي">
        <svg class="moon-icon" viewBox="0 0 24 24"><path d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.39 5.39 0 0 1-4.4 2.26 5.4 5.4 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1z"/></svg>
        <svg class="sun-icon" viewBox="0 0 24 24"><path d="M12 17a5 5 0 1 1 0-10 5 5 0 0 1 0 10zm0-13a1 1 0 0 1 1 1v1a1 1 0 1 1-2 0V5a1 1 0 0 1 1-1zm0 14a1 1 0 0 1 1 1v1a1 1 0 1 1-2 0v-1a1 1 0 0 1 1-1zM4 12a1 1 0 0 1 1-1h1a1 1 0 1 1 0 2H5a1 1 0 0 1-1-1zm14 0a1 1 0 0 1 1-1h1a1 1 0 1 1 0 2h-1a1 1 0 0 1-1-1zM6.34 6.34a1 1 0 0 1 1.42 0l.7.7a1 1 0 1 1-1.41 1.42l-.71-.71a1 1 0 0 1 0-1.41zm9.9 9.9a1 1 0 0 1 1.42 0l.7.7a1 1 0 0 1-1.41 1.42l-.71-.71a1 1 0 0 1 0-1.41zm1.42-9.9a1 1 0 0 1 0 1.41l-.71.71A1 1 0 0 1 15.54 7l.7-.7a1 1 0 0 1 1.42 0zM7.04 16.24a1 1 0 0 1 0 1.41l-.7.71a1 1 0 1 1-1.42-1.42l.71-.7a1 1 0 0 1 1.41 0z"/></svg>
      </button>
      <button class="burger" id="burger" aria-label="القائمة"><span></span><span></span><span></span></button>
    </div>
  </div>
</header>

<main>

<!-- ===================== القسم الرئيسي ===================== -->
<section class="hero" id="home">
  <div class="container">
    <div class="hero-grid">

      <div class="hero-text">
        <div class="hero-badge reveal">
          <span class="pulse"></span>
          متاح للتعاون والمشاريع البرمجية
        </div>

        <h1 class="reveal" data-d="1">
          مرحباً، أنا <span class="grad">المعتصم بالله</span><br>
          الرميلي
        </h1>

        <p class="role reveal" data-d="2">
          طالب <b>هندسة برمجيات</b> — كلية تقنية المعلومات، جامعة المرقب
        </p>

        <p class="lead reveal" data-d="3">
          شغوف بعالم البرمجة وتطوير الويب، أسعى دائماً لتطوير مهاراتي وبناء حلول
          تقنية عملية وأنيقة. أهتم بتعلّم كل جديد في مجال هندسة البرمجيات
          وأحب العمل الجماعي والانضباط.
        </p>

        <div class="hero-cta reveal" data-d="4">
          <a href="#contact" class="btn btn-primary">
            <svg viewBox="0 0 24 24"><path d="M1.5 6.75A2.25 2.25 0 0 1 3.75 4.5h16.5a2.25 2.25 0 0 1 2.25 2.25v10.5a2.25 2.25 0 0 1-2.25 2.25H3.75A2.25 2.25 0 0 1 1.5 17.25zm2.25-.75a.75.75 0 0 0-.75.75v.44l9 5.4 9-5.4v-.44a.75.75 0 0 0-.75-.75z"/></svg>
            تواصل معي
          </a>
          <a href="#about" class="btn btn-ghost">
            <svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm1 15h-2v-6h2zm0-8h-2V7h2z"/></svg>
            تعرّف عليّ أكثر
          </a>
        </div>

        <div class="hero-socials reveal" data-d="5">
          <a class="soc-mini fb" href="https://www.facebook.com/AlRumaili" target="_blank" rel="noopener" aria-label="فيسبوك" title="فيسبوك">
            <svg viewBox="0 0 24 24"><path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.45 2.89h-2.33v6.99A10 10 0 0 0 22 12z"/></svg>
          </a>
