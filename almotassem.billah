<!-- ===================== نبذة عني ===================== -->
<section id="about">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">نبذة عني</span>
      <h2>معلوماتي <em>الشخصية</em></h2>
      <p>لمحة سريعة عن هويتي وبياناتي الأساسية.</p>
    </div>

    <div class="about-grid">

      <div class="info-card reveal" data-d="1">
        <div class="info-icon">
          <svg viewBox="0 0 24 24"><path d="M12 12a5 5 0 1 0-5-5 5 5 0 0 0 5 5zm0 2c-4.42 0-8 2.24-8 5v1h16v-1c0-2.76-3.58-5-8-5z"/></svg>
        </div>
        <h4>الاسم الكامل</h4>
        <p>المعتصم بالله محمد عبد السلام الرميلي</p>
      </div>

      <div class="info-card reveal" data-d="2">
        <div class="info-icon">
          <svg viewBox="0 0 24 24"><path d="M7 2v2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-2V2h-2v2H9V2zm12 8v10H5V10zM7 12v2h5v-2z"/></svg>
        </div>
        <h4>تاريخ الميلاد</h4>
        <p>30 أكتوبر 2002</p>
      </div>

      <div class="info-card reveal" data-d="3">
        <div class="info-icon">
          <svg viewBox="0 0 24 24"><path d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 14.5 9 2.5 2.5 0 0 1 12 11.5z"/></svg>
        </div>
        <h4>مكان الميلاد</h4>
        <p>مدينة الخمس — ليبيا</p>
      </div>

      <div class="info-card reveal" data-d="4">
        <div class="info-icon">
          <svg viewBox="0 0 24 24"><path d="M12 2 1 7l11 5 9-4.09V17h2V7zm-7 9.18V17l7 3 7-3v-5.82l-7 3.18z"/></svg>
        </div>
        <h4>الأصل</h4>
        <p>قصر الأخيار — العلوص</p>
      </div>

      <div class="info-card reveal" data-d="1">
        <div class="info-icon">
          <svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm1 15h-2v-6h2zm0-8h-2V7h2z"/></svg>
        </div>
        <h4>الجنسية</h4>
        <p>ليبي 🇱🇾</p>
      </div>

      <div class="info-card reveal" data-d="2">
        <div class="info-icon">
          <svg viewBox="0 0 24 24"><path d="M12 12a5 5 0 1 0-5-5 5 5 0 0 0 5 5zm0 2c-4.42 0-8 2.24-8 5v1h16v-1c0-2.76-3.58-5-8-5z"/></svg>
        </div>
        <h4>الجنس</h4>
        <p>ذكر</p>
      </div>

      <div class="info-card reveal" data-d="3">
        <div class="info-icon">
          <svg viewBox="0 0 24 24"><path d="M12 2 4 6v6c0 5.25 3.4 10.14 8 11 4.6-.86 8-5.75 8-11V6zm0 6a2 2 0 1 1-2 2 2 2 0 0 1 2-2z"/></svg>
        </div>
        <h4>الديانة</h4>
        <p>الإسلام ☪</p>
      </div>

      <div class="info-card reveal" data-d="4">
        <div class="info-icon">
          <svg viewBox="0 0 24 24"><path d="M12 21.35 10.55 20C5.4 15.36 2 12.28 2 8.5A5.5 5.5 0 0 1 7.5 3 6 6 0 0 1 12 5.09 6 6 0 0 1 16.5 3 5.5 5.5 0 0 1 22 8.5c0 3.78-3.4 6.86-8.55 11.54z"/></svg>
        </div>
        <h4>الحالة الاجتماعية</h4>
        <p>أعزب</p>
      </div>

      <div class="info-card reveal" data-d="5">
        <div class="info-icon">
          <svg viewBox="0 0 24 24"><path d="M12 2s-6 6.5-6 11a6 6 0 0 0 12 0c0-4.5-6-11-6-11z"/></svg>
        </div>
        <h4>فصيلة الدم</h4>
        <p><span class="blood">B+</span></p>
      </div>

    </div>
  </div>
</section>

<!-- ===================== التعليم ===================== -->
<section id="education">
  <div class="container">
    <div class="section-head reveal">
